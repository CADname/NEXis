# Copy this file to .env and replace every CHANGE_ME value before deployment.
ADMIN_USER=admin
ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD
# Set true when the browser reaches NEXis over HTTPS.
COOKIE_SECURE=false
POSTGRES_DB=nexis
POSTGRES_USER=nexis
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
MQTT_HOST=mqtt
MQTT_PORT=1883
MQTT_TOPIC=nexis/esp32/#
MQTT_DEVICE_ID=rotor_rig_01
REMOTE_RPM_MIN=100
REMOTE_RPM_MAX=1500
REMOTE_ARM_SECONDS=60
CONTROL_COMMAND_TTL_MS=5000
EDGE_ONLINE_TIMEOUT_MS=8000
PHYSICAL_AI_MIN_RPM_RATIO=0.70
