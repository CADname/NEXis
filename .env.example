# Copy to .env and replace every CHANGE_ME value before deployment.
COOKIE_SECURE=false

POSTGRES_DB=nexis
POSTGRES_USER=nexis
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD

MQTT_HOST=mqtt
MQTT_PORT=1883
MQTT_TOPIC=nexis/esp32/#
MQTT_DEVICE_ID=rotor_rig_01

REMOTE_RPM_MIN=100
REMOTE_RPM_MAX=1500
REMOTE_ARM_SECONDS=60
CONTROL_COMMAND_TTL_MS=5000
EDGE_ONLINE_TIMEOUT_MS=8000
PHYSICAL_AI_MIN_RPM_RATIO=0.70

# Use a long random value. The Windows Vision Edge retrieves it after entering Physical Station.
VISION_EDGE_TOKEN=CHANGE_ME_RANDOM_VISION_EDGE_TOKEN
VISION_MAX_FRAME_BYTES=3500000
VISION_FRAME_MAX_AGE_SECONDS=10
